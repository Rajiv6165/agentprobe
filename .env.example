# ==============================================================================
# AgentProbe Environment Configuration Template
# Copy this file to .env and configure values as needed.
# ==============================================================================

# Database Configuration (PostgreSQL 16+)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentprobe

# API Database Connection URLs
AGENTPROBE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentprobe
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentprobe

# API Security and Server Settings
AGENTPROBE_API_KEY=
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
ENVIRONMENT=development

# SDK Ingestion and Tracing Settings
AGENTPROBE_ENDPOINT=http://localhost:8000
AGENTPROBE_PROJECT=default
AGENTPROBE_EXPORTER=http
AGENTPROBE_JSONL_PATH=traces.jsonl
AGENTPROBE_BATCH_SIZE=100
AGENTPROBE_FLUSH_INTERVAL=1.0
AGENTPROBE_MAX_QUEUE_SIZE=10000
AGENTPROBE_MAX_PAYLOAD_SIZE=65536

# Optional Real LLM Provider (for demo agent; leave unset to use MockLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

